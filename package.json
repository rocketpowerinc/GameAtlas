{
  "name": "gameatlas",
  "version": "1.19.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "vite build && node scripts/build-desktop.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-game-lookup.mjs && node scripts/test-store.mjs && node scripts/test-backup.mjs && node scripts/test-preferences.mjs && node scripts/test-updates.mjs && node scripts/test-portable.mjs && node scripts/test-artwork-scan.mjs && node scripts/test-description-scan.mjs && node scripts/test-dashboard.mjs && node scripts/test-esrb.mjs && node scripts/test-pdf-export.mjs",
    "test:desktop": "electron . --smoke-test",
    "dist": "npm run build && electron-builder --win --x64",
    "build:branding": "electron scripts/build-branding.cjs"
  },
  "dependencies": {},
  "devDependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "@fontsource/geist": "^5.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.0"
  },
  "type": "module",
  "description": "Your personal Windows game collection",
  "author": "rocketpowerinc",
  "main": "desktop-dist/main.cjs",
  "build": {
    "appId": "com.rocketpowerinc.gameatlas",
    "productName": "GameAtlas",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop-dist/**/*",
      "data/library.json",
      "public/icon-512.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "GameAtlas.Setup.${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico"
    },
    "portable": {
      "artifactName": "GameAtlas.Portable.${version}.${ext}",
      "requestExecutionLevel": "user"
    },
    "asar": true
  }
}
